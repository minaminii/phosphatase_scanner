<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ project_name }} – Phosphatase Scanner Report</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        .seq-container {
            font-family: "Courier New", monospace;
            white-space: pre-wrap;
            word-break: break-all;        /* forces break in long sequences */
            overflow-wrap: anywhere;      /* improves wrapping behavior */
            background: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
        }
        .highlight {
            background: yellow;
            font-weight: bold;
        }
    </style>
</head>

<body class="bg-light">

<div class="container my-4">

    <!-- ======================================
         HEADER FLEX: RUN DETAILS + CHART
    ======================================= -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-5 gap-4">

        <!-- LEFT: RUN INFO -->
        <div class="flex-fill p-3 border rounded bg-white">
            <h4 class="mb-3">Run Details</h4>
            <table class="table table-sm">
                <tr><th>Project Name</th><td>{{ project_name }}</td></tr>
                <tr><th>Timestamp</th><td>{{ timestamp }}</td></tr>
                <tr><th>Database</th><td>{{ database }}</td></tr>
                <tr><th>Total Sequences</th><td>{{ sequences | length }}</td></tr>
            </table>
        </div>

        <!-- RIGHT: FOLD FAMILY CHART -->
        <div class="flex-fill p-3 border rounded bg-white">
            <h4 class="mb-3">Fold-Family Distribution</h4>
            <canvas id="foldChart"></canvas>
        </div>

    </div>

    <!-- ======================================
         SUMMARY TABLE
    ======================================= -->
    <h3 class="mb-3">Matched Sequences</h3>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
        <tr>
            <th>Accession</th>
            <th>Status</th>
            <th>Fold Family</th>
            <th>E-value</th>
            <th>Confidence</th>
            <th>Detail</th>
        </tr>
        </thead>
        <tbody>
        {% for seq in sequences -%}
            {% set parts = seq.description.split() -%}
            {# Expected format:
               UPI00018555B2 status=active fold_family=CC3 confidence=High-confidence evalue=5.4e-30 #}
            {% set status = (parts[1].split("=")[1]) -%}
            {% set family = (parts[2].split("=")[1]) -%}
            {% set confidence = (parts[3].split("=")[1]) -%}
            {% set evalue = (parts[4].split("=")[1]) -%}
            <tr>
                <td>{{ seq.id }}</td>
                <td>{{ status }}</td>
                <td>{{ family }}</td>
                <td>{{ evalue }}</td>
                <td>{{ confidence }}</td>
                <td>
                    <button class="btn btn-primary btn-sm"
                            data-bs-toggle="collapse"
                            data-bs-target="#detailRow{{ loop.index }}"
                            aria-expanded="false">
                        Detail
                    </button>
                </td>
            </tr>
            <!-- Detail Row -->
            <tr class="collapse" id="detailRow{{ loop.index }}">
                <td colspan="5">
                    <h6>Full Sequence (e-value: {{ evalue }})</h6>
                    <div class="seq-container">
                        {{ seq.seq | safe }}
                    </div>
                </td>
            </tr>
        {%- endfor %}
        </tbody>
    </table>
</div>


<!-- ======================================
     JS: BOOTSTRAP + CHART.JS
======================================= -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Data injected from Python context
    const foldLabels = {{ fold_family_counts.keys() | list | tojson }};
    const foldValues = {{ fold_family_counts.values() | list | tojson }};

    new Chart(document.getElementById('foldChart'), {
        type: 'doughnut',
        data: {
            labels: foldLabels,
            datasets: [{
                data: foldValues,
                backgroundColor: ["#4e79a7", "#f28e2b", "#e15759", "#76b7b2"]
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: "bottom" } }
        }
    });
</script>

</body>
</html>
