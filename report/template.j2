<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ project_name }} – Phosphatase Scanner Report</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        .seq-container {
            font-family: "Courier New", monospace;
            white-space: pre-wrap;
            word-break: break-all;        /* forces break in long sequences */
            overflow-wrap: anywhere;      /* improves wrapping behavior */
            background: #f8f9fa;
            padding: 15px;
            border-radius: 5px;
        }
        .seq-highlight {
            background-color: #fff3a0; /* soft yellow highlight */
            color: #222;
            padding: 0.1em 0.25em;
            border-radius: 0.2em;
            font-weight: 500;
        }
        tr.dt-ignore {
            display: none !important;
        }
    </style>
</head>

<body class="bg-light">

<div class="container my-4">

    <!-- ======================================
         HEADER FLEX: RUN DETAILS + CHART
    ======================================= -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-5 gap-4">

        <!-- LEFT: RUN INFO -->
        <div class="flex-fill p-3 border rounded bg-white">
            <h4 class="mb-3">Run Details</h4>
            <table class="table table-sm">
                <tr><th>Project Name</th><td>{{ project_name }}</td></tr>
                <tr><th>Timestamp</th><td>{{ timestamp }}</td></tr>
                <tr><th>Database</th><td>{{ database }}</td></tr>
                <tr><th>Total Sequences</th><td>{{ sequences | length }}</td></tr>
            </table>
        </div>

        <!-- RIGHT: FOLD FAMILY CHART -->
        <div class="flex-fill p-3 border rounded bg-white">
            <h4 class="mb-3">Fold-Family Distribution</h4>
            <div id="foldChart" class="sunburst-container"></div>
        </div>

    </div>

    <!-- ======================================
         SUMMARY TABLE
    ======================================= -->
    <h3 class="mb-3">Matched Sequences</h3>

<table id="matchedSequencesTable"
       class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th></th>
            <th>Sequence ID</th>
            <th>Fold Family</th>
            <th># Matches</th>
            <th>E-value</th>
            <th>Confidence</th>
        </tr>
    </thead>

    <tbody>
    {% for record in sequences %}
        <tr data-details='{{ record | tojson | e }}'>
            <td class="details-control text-center" style="cursor:pointer;">
                <i class="bi bi-caret-right-fill"></i>
            </td>
            <td>{{ record.sequence_id }}</td>
            <td>{{ record.motif }}</td>
            <td>{{ record.n_matches }}</td>
            <td>{{ record["e-value"] }}</td>
            <td>{{ record["HMM confidence"] }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>


</div>


<!-- ======================================
     JS: BOOTSTRAP + D3.JS
======================================= -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/2.3.5/js/dataTables.min.js"></script>

<script>
function formatDetails(record) {
    let matches = record.matches.map(m => `
        <tr>
            <td>${m.match}</td>
            <td>${m.pattern}</td>
            <td>${m.start}</td>
            <td>${m.end}</td>
            <td>${m.match_type}</td>
            <td>${m.description}</td>
        </tr>
    `).join("");

    return `
        <div class="p-3">
            <h6>Match Positions</h6>
            <table class="table table-sm table-bordered mb-3">
                <thead class="table-light">
                    <tr>
                        <th>Match</th>
                        <th>Pattern</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Type</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    ${matches}
                </tbody>
            </table>

            <h6>Full Sequence</h6>
            <div class="seq-container">
                ${record.sequence_html}
            </div>
        </div>
    `;
}

$(document).ready(function () {

    if ($.fn.DataTable.isDataTable('#matchedSequencesTable')) {
        return;
    }

    const table = $('#matchedSequencesTable').DataTable({
        order: [[4, 'asc']],
        columnDefs: [
            { orderable: false, targets: 0 }
        ]
    });

    $('#matchedSequencesTable tbody').on('click', 'td.details-control', function () {
        const tr = $(this).closest('tr');
        const row = table.row(tr);
        const record = JSON.parse(tr.attr('data-details'));

        if (!record) {
            console.error("No record data found", tr);
            return;
        }
        const icon = tr.find('.details-control i');
        if (row.child.isShown()) {
            row.child.hide();
            icon
            .removeClass('bi-caret-down-fill')
            .addClass('bi-caret-right-fill');
        } else {
            row.child(formatDetails(record)).show();
            icon
            .removeClass('bi-caret-right-fill')
            .addClass('bi-caret-down-fill');
        }
    });
});
</script>



<script src="https://d3js.org/d3.v7.min.js"></script>
<script>
    const sunburstData = {{ fold_family_counts | tojson }};
</script>
<script>
const data = {{ fold_family_counts | tojson }};

// ---------- Responsive sizing ----------
const container = d3.select("#foldChart");
const width = container.node().getBoundingClientRect().width;
const radius = width / 2;

// Clear on re-render (important if resizing / HTMX / reloads)
container.selectAll("*").remove();

// ---------- Tooltip ----------
const tooltip = d3.select("body")
    .append("div")
    .style("position", "absolute")
    .style("background", "#fff")
    .style("border", "1px solid #ccc")
    .style("padding", "8px 10px")
    .style("border-radius", "4px")
    .style("font-size", "12px")
    .style("pointer-events", "none")
    .style("opacity", 0);

// ---------- SVG ----------
const svg = container.append("svg")
    .attr("viewBox", `${-radius} ${-radius} ${width} ${width}`)
    .style("width", "100%")
    .style("height", "auto");

// ---------- Color ----------
const color = d3.scaleOrdinal(d3.schemeTableau10);

const matchTypeColor = d3.scaleOrdinal()
    .domain(["exact", "relaxed", "remnant", "no match"])
    .range(["#1b9e77", "#7570b3", "#e6ab02", "#d95f02"]);

// ---------- Hierarchy ----------
const root = d3.hierarchy(data)
    .sum(d => d.value)
    .sort((a, b) => b.value - a.value);

d3.partition()
    .size([2 * Math.PI, radius])(root);

// ---------- Arc ----------
const arc = d3.arc()
    .startAngle(d => d.x0)
    .endAngle(d => d.x1)
    .innerRadius(d => d.y0)
    .outerRadius(d => d.y1);

// ---------- Draw arcs ----------
svg.selectAll("path")
    .data(root.descendants().filter(d => d.depth))
    .join("path")
    .attr("d", arc)
    .attr("fill", d => {
        // Inner ring → fold family color
        if (d.depth === 1) {
            return color(d.data.name);
        }

        // Outer ring → SAME fold color as parent
        if (d.depth === 2) {
            return color(d.parent.data.name);
        }

        return "#ccc";
    })
    .attr("fill-opacity", d => {
        // Shade outer ring by match type
        if (d.depth !== 2) return 1;

        return {
            Exact: 1.0,
            Relaxed: 0.75,
            Remnant: 0.5,
            "No match": 0.25
        }[d.data.name] ?? 0.6;
    })
    .attr("stroke", "#fff")
    .on("mousemove", (event, d) => {
        tooltip
            .style("opacity", 1)
            .html(`
                <strong>${d.data.name}</strong><br/>
                Motif: ${d.depth === 1 ? d.data.name : d.parent.data.name}<br/>
                Count: ${d.value}
            `)
            .style("left", `${event.pageX + 12}px`)
            .style("top", `${event.pageY + 12}px`);
    })
    .on("mouseleave", () => {
        tooltip.style("opacity", 0);
    });

// ---------- Labels (INNER + OUTER) ----------
svg.selectAll("text")
    .data(root.descendants().filter(d => d.depth))
    .join("text")
    .attr("transform", d => {
        const angle = (d.x0 + d.x1) / 2 * 180 / Math.PI;
        const r = (d.y0 + d.y1) / 2;
        return `
            rotate(${angle - 90})
            translate(${r},0)
            rotate(${angle < 180 ? 0 : 180})
        `;
    })
    .attr("dy", "0.35em")
    .attr("font-size", d => d.depth === 1 ? "11px" : "9px")
    .attr("text-anchor", "middle")
    .attr("pointer-events", "none")
    .text(d => {
        const angle = d.x1 - d.x0;
        return angle > 0.15 ? d.data.name : "";
    });
</script>

</body>
</html>
